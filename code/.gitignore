# -----------------------------------------------------------------------------
# Git ignore rules for this Flutter application.
#
# These rules take precedence over the repository-root .gitignore for any path
# under code/, because git applies .gitignore files from the root down toward the
# file in question, letting the deeper file's rules win.
#
# Platform-specific rules continue to live in the per-platform files generated by
# `flutter create` (android/.gitignore, ios/.gitignore, macos/.gitignore,
# linux/.gitignore, windows/.gitignore).
# -----------------------------------------------------------------------------

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Lockfiles must be committed for an application: pubspec.lock pins the exact
# resolved dependency versions so that every machine and CI run builds against
# the same packages.
#
# The repository-root .gitignore is copied from the Flutter SDK repository and
# contains a broad `*.lock` rule (appropriate there, where lockfiles are
# vendored, but not for an app). Negate it here so this project's pubspec.lock
# and platform lockfiles stay tracked. Build-time locks such as
# android/.gradle/**/*.lock remain ignored via android/.gitignore.
!*.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/